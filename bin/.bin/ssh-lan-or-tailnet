#!/bin/sh

# This script should be compatible with macOS, current Arch Linux, and Debian Trixie.

if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    cat <<'EOF'
Usage: ssh-lan-or-tailnet HOST PORT

Try HOST.local on the SSH port first. If it is reachable, connect there;
otherwise connect to HOST, which should resolve through Tailscale.

Add this to ~/.ssh/config:

Host arrietty sheeta kamaji moro
    ProxyCommand ~/.bin/ssh-lan-or-tailnet %h %p
EOF
    exit 0
fi

if [ "$#" -ne 2 ]; then
    echo "Usage: ssh-lan-or-tailnet HOST PORT (or --help)" >&2
    exit 2
fi

host=$1
port=$2

if nc -4 -z -w 2 "$host.local" "$port" >/dev/null 2>&1; then
    exec nc -4 "$host.local" "$port"
fi

exec nc "$host" "$port"
