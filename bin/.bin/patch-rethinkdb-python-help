#!/usr/bin/env bash
# Patches the locally installed `rethinkdb` PyPI package (via pipx) so that
# rethinkdb-dump/restore/export/import/index-rebuild --help doesn't crash.
#
# Upstream bug: rethinkdb/utils_common.py's CommonOptionChecker.take_action()
# raises "Destination can not be none" for ANY option with dest=None, but
# optparse's built-in -h/--help option always has dest=None by design. This
# has been present in every rethinkdb release back to 2.4.4 and is unreported
# upstream (github.com/rethinkdb/rethinkdb-python has no issue/PR for it).
# Real usage (passing actual flags) is unaffected; only bare --help crashes.
#
# Safe to re-run: no-ops if already patched, and re-patches after
# `pipx upgrade rethinkdb` / `pipx reinstall rethinkdb` restores the bug.
set -euo pipefail

target=$(find "$HOME/.local/pipx/venvs/rethinkdb/lib" -maxdepth 4 -path "*/site-packages/rethinkdb/utils_common.py" 2>/dev/null | head -1)

if [ -z "$target" ]; then
    echo "patch-rethinkdb-python-help: rethinkdb pipx venv not found, nothing to patch." >&2
    exit 1
fi

python3 - "$target" <<'PYEOF'
import sys

path = sys.argv[1]
src = open(path).read()

broken = '''            def take_action(self, action, dest, opt, value, values, parser):
                if dest is None:
                    raise AssertionError("Destination can not be none")

                if action == "add_key":
                    if self.metavar is None:
                        raise AssertionError("Metavar can not be none")
'''

fixed = '''            def take_action(self, action, dest, opt, value, values, parser):
                if action == "add_key":
                    if dest is None:
                        raise AssertionError("Destination can not be none")
                    if self.metavar is None:
                        raise AssertionError("Metavar can not be none")
'''

if fixed in src:
    print(f"patch-rethinkdb-python-help: already patched ({path})")
    sys.exit(0)

if broken not in src:
    sys.exit(f"patch-rethinkdb-python-help: expected snippet not found in {path}, "
              "package version may have changed, refusing to patch")

open(path, "w").write(src.replace(broken, fixed, 1))
print(f"patch-rethinkdb-python-help: patched {path}")
PYEOF
