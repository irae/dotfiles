#!/bin/sh
set -eu

main_dir="$HOME/.pi/agent"
rpiv_dir="$HOME/.pi-rpiv"
super_dir="$HOME/.pi-super"
auth_file="$main_dir/auth.json"

if [ ! -f "$auth_file" ]; then
    printf 'Main Pi auth file not found: %s\n' "$auth_file" >&2
    exit 1
fi

ensure_link() {
    source=$1
    target=$2
    if [ -L "$target" ]; then
        if [ "$(readlink "$target")" = "$source" ]; then
            return
        fi
        printf 'Refusing to replace symlink: %s\n' "$target" >&2
        exit 1
    fi
    if [ -e "$target" ]; then
        printf 'Refusing to replace existing file: %s\n' "$target" >&2
        exit 1
    fi
    ln -s "$source" "$target"
}

mkdir -p "$rpiv_dir/sessions" "$super_dir/sessions"
ensure_link "$auth_file" "$rpiv_dir/auth.json"
ensure_link "$auth_file" "$super_dir/auth.json"

if [ -f "$main_dir/web-search.json" ]; then
    ensure_link "$main_dir/web-search.json" "$super_dir/web-search.json"
elif [ -f "$HOME/.pi/web-search.json" ]; then
    ensure_link "$HOME/.pi/web-search.json" "$super_dir/web-search.json"
else
    printf 'No main Pi web-search.json found; skipping shared web-access config.\n' >&2
fi
